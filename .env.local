# 🌐 URL base do backend (ajusta se o servidor mudar de domínio)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ⚙️ Porta local do front-end (Next.js)
PORT=3000

# ✅ Ambiente de desenvolvimento
NODE_ENV=development

# 🔐 Chave pública opcional (usada para logs ou integração futura)
NEXT_PUBLIC_APP_NAME=SuazoBarber
